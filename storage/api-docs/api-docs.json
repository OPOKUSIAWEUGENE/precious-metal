                                        "nullable": true,
                                        "example": "1990-01-01"
                                    },
                                    "nationality": {
                                        "type": "string",
                                        "nullable": true,
                                        "example": "Ghanaian"
                                    },
                                    "resident_address": {
                                        "type": "string",
                                        "nullable": true,
