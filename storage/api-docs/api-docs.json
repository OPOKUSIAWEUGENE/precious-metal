                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345"
                                    },
                                    "confirm_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345"
                                    },
                                    "phone_number": {
                                        "type": "string",
                                        "example": "+233240000000"
                                    },
                                    "date_of_birth": {
