                "operationId": "7fa1159c161cd00905063308c3d37b02",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                                    "application/json": {
                                        "example": {
                                            "data": {
                                                "token": "a2636ba5-10c4-4c2c-87ef-51c6b526e55f|F7YA08MSz0P1TcRvJijUIP1Q6rOOEByUtmfX1jp26c4a5496",
                                                "user": {
                                                    "id": "a2614e64-d087-488d-87ff-52e5437f932f",
                                                    "email": "admin@gmail.com",
                                                    "first_name": "System",
                                                    "last_name": "Admin",
                                                    "phone_number": "+233200000000",
                                                    "active": true,
                                                    "role": "admin"
                                                }
                                            },
                                            "status": "success"
                                        },
                                        "schema": {
                                            "properties": {
                                                "data": {
                                            "type": "object",
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "1|customer_sanctum_token_example"
                                                },
                                                "customer": {
                                                    "type": "object",
                                                    "properties": {
                                                        "id": {
                                                            "type": "string",
                                                            "format": "uuid",
                                                            "example": "00000000-0000-0000-0000-000000000001"
                                                        },
                                                        "email": {
                                                            "type": "string",
                                                            "format": "email",
                                                            "example": "customer@gmail.com"
                                                        },
                                                        "first_name": {
                                                            "type": "string",
                                                            "example": "John"
                                                        },
                                                        "last_name": {
                                                            "type": "string",
                                                            "example": "Customer"
                                                        },
                                                        "date_of_birth": {
                                                            "type": "string",
                                                            "nullable": true,
                                                            "example": "1990-01-01"
                                                        },
                                                        "nationality": {
                                                            "type": "string",
                                                            "nullable": true,
                                                            "example": "Ghanaian"
                                                        },
                                                        "resident_address": {
                                                            "type": "string",
                                                            "nullable": true,
                                                            "example": "123 Tech Street, Accra"
                                                        },
                                                        "selfie": {
                                                            "type": "string",
                                                            "nullable": true,
                                                            "example": null
                                                        },
                                                        "phone_number": {
                                                            "type": "string",
                                                            "example": "+233240000000"
                                                        },
                                                        "kyc": {
                                                            "type": "string",
                                                            "nullable": true,
                                                            "example": null
                                                        },
                                                        "card_details": {
                                                            "type": "string",
                                                            "nullable": true,
                                                            "example": null
                                                        },
                                                        "active": {
                                                            "type": "boolean",
                                                            "example": true
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
