                                    "selfie": {
                                        "type": "string",
                                        "nullable": true,
                                        "example": null
                                    },
                                    "kyc": {
                                        "type": "array",
                                        "nullable": true,
                                        "example": null
                                    },
                                    "card_details": {
                                        "type": "array",
                                        "nullable": true,
                                        "example": null
                                    }
