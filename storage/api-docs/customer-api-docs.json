{
    "openapi": "3.0.0",
    "info": {
        "title": "Customer API",
        "description": "API documentation for Customer Authentication and profile management.",
        "contact": {
            "email": "customer-support@neutek.local"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Primary API Server"
        }
    ],
    "paths": {
        "/v0/auth/customers/login": {
            "post": {
                "tags": [
                    "Customer Authentication"
                ],
                "summary": "Customer Login",
                "operationId": "7fa1159c161cd00905063308c3d37b02",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@neutek.local"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/v0/auth/customers/register": {
            "post": {
                "tags": [
                    "Customer Authentication"
                ],
                "summary": "Customer Registration",
                "operationId": "16611c1308db58c1ed61d490a5a6d000",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "John"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john.doe@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registration successful"
                    },
                    "400": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/v0/auth/customers/password/request": {
            "post": {
                "tags": [
                    "Customer Authentication"
                ],
                "summary": "Request Customer Password Reset",
                "operationId": "c90393c8273e2adc1447d0f310d2098c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@neutek.local"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset link sent"
                    },
                    "404": {
                        "description": "Customer not found"
                    }
                }
            }
        },
        "/v0/auth/customers/password/reset": {
            "post": {
                "tags": [
                    "Customer Authentication"
                ],
                "summary": "Reset Customer Password",
                "operationId": "e1716d3a1fab9c679eb675f34b153e52",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@neutek.local"
                                    },
                                    "token": {
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successful"
                    },
                    "400": {
                        "description": "Invalid token or data"
                    }
                }
            }
        },
        "/v0/auth/customers/logout": {
            "post": {
                "tags": [
                    "Customer Authentication"
                ],
                "summary": "Customer Logout",
                "operationId": "431dd6a856c78571cd923d4dc5b9c26a",
                "responses": {
                    "200": {
                        "description": "Logged out successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "tags": [
        {
            "name": "Customer Authentication",
            "description": "Customer Authentication"
        }
    ],
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Enter token in format (Bearer <token>)",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "security": [
        {
            "sanctum": []
        }
    ]
}