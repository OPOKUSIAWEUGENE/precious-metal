        },
        "/v0/auth/customers/gold-wallets": {
            "get": {
                "tags": [
                    "Assets"
                ],
                "summary": "Get the authenticated customer's gold wallets",
                "description": "Returns the current authenticated customer wallets from the shared gold wallet store.",
                "operationId": "4395f1da28160e0017e0d2b8924a41be",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/GoldWallet"
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "GoldWallet": {
                "title": "Gold Wallet",
                "description": "A gold wallet belonging to a user.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "wallet_reference": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "available_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "reserved_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "weight_unit": {
                        "type": "string",
                        "example": "gram"
                    },
                    "purity": {
                        "type": "string",
                        "example": "0.999900"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "last_transaction_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer",
                "description": "Enter your Sanctum token"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Customer authentication and session endpoints"
        },
        {
            "name": "Assets",
            "description": "Customer assets and gold wallets"
        },
        {
            "name": "Customer",
            "description": "Customer profile and account management"
        }
    ]
}