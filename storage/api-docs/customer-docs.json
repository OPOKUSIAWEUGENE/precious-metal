    "components": {
        "schemas": {
            "AssetWallet": {
                "title": "Asset Wallet",
                "description": "A polymorphic asset wallet belonging to a customer or platform user.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "owner_type": {
                        "type": "string",
                        "example": "App\\\\Modules\\\\v0\\\\Customers\\\\Models\\\\Customer"
                    },
                    "owner_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "user_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "wallet_reference": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "available_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "reserved_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "weight_unit": {
                        "type": "string",
                        "example": "gram"
                    },
                    "purity": {
                        "type": "string",
                        "example": "0.999900"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "last_transaction_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Withdrawal": {
                "title": "Withdrawal",
                "description": "An asset withdrawal request.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "asset_wallet_id": {
                        "type": "integer"
                    },
                    "owner_type": {
                        "type": "string"
                    },
                    "owner_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "rate_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "requested_amount": {
                        "type": "string",
                        "example": "2.00000000"
                    },
                    "asset_amount": {
                        "type": "string",
                        "example": "2.00000000"
                    },
                    "cash_amount": {
                        "type": "string",
                        "example": "2500.00"
                    },
                    "conversion_rate": {
                        "type": "string",
                        "example": "1250.0000"
                    },
                    "conversion_type": {
                        "type": "string",
                        "example": "gold_to_cash"
                    },
                    "status": {
                        "type": "string",
                        "example": "pending"
                    },
                    "notes": {
                        "type": "string",
                        "nullable": true
                    },
                    "approved_by": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "approved_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "rejected_by": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "rejected_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "rejection_reason": {
                        "type": "string",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "CustomerRate": {
                "title": "Customer Rate",
                "description": "A customer-facing active rate entry.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "rate_type": {
                        "type": "string",
                        "example": "buying",
                        "enum": [
                            "buying",
                            "selling"
                        ]
                    },
                    "rate": {
                        "type": "string",
                        "example": "1250.0000"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "effective_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "notes": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer",
                "description": "Enter your Sanctum token"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Customer authentication and session endpoints"
        },
        {
            "name": "Assets",
            "description": "Customer assets and gold wallets"
        },
        {
            "name": "Customer",
            "description": "Customer profile and account management"
        },
        {
            "name": "Customers",
            "description": "Customers"
        }
    ]
