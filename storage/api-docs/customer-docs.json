                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Reset token generated"
                    },
                    "404": {
                        "description": "Customer not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/v0/customers/{id}/deactivate": {
            "put": {
                "tags": [
                    "Customers"
                ],
                "summary": "Deactivate a customer (Admin)",
                "operationId": "3554f8e025c17384ebaf1592e4ca73df",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Customer deactivated successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/v0/customers/{id}/activate": {
            "put": {
                "tags": [
                    "Customers"
                ],
                "summary": "Activate a customer (Admin)",
                "operationId": "c0141b4a3ec34de6860a20d390953ddb",
