        "/v0/customers/{id}/password/request": {
            "post": {
                "tags": [
                    "Customer"
                ],
                "summary": "Request a password reset for a customer",
                "operationId": "02431dff08180e5d4ee9d4f764bdb4d3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
