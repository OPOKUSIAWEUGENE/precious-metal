                    }
                ]
            }
        }
    },
    "tags": [
        {
            "name": "Customer API",
            "description": "Customer-facing endpoints and authentication"
        }
    ],
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Enter token in format (Bearer <token>)",
                "name": "Authorization",
                "in": "header"
            },
            "accept": {
                "type": "apiKey",
                "description": "Accept application/json",
                "name": "Accept",
                "in": "header"
            }
        }
    },
    "security": [
