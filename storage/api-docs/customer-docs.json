{
    "openapi": "3.0.0",
    "info": {
        "title": "Precious Metal API",
        "description": "API documentation for the Precious Metal platform, including Platform Operator and Customer modules.",
        "contact": {
            "email": "support@neutek.local"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api",
            "description": "Primary API Server"
        }
    ],
    "paths": {
        "/v0/auth/customers/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Customer Login",
                "operationId": "7fa1159c161cd00905063308c3d37b02",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@neutek.local"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v0/auth/customers/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Customer Registration",
                "operationId": "16611c1308db58c1ed61d490a5a6d000",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "John"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john.doe@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registration successful",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v0/auth/customers/password/request": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Request Customer Password Reset",
                "operationId": "c90393c8273e2adc1447d0f310d2098c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@neutek.local"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset link sent",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "404": {
                        "description": "Customer not found",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v0/auth/customers/password/reset": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Reset Customer Password",
                "operationId": "e1716d3a1fab9c679eb675f34b153e52",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "customer@neutek.local"
                                    },
                                    "token": {
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successful",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid token or data",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v0/auth/customers/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Customer Logout",
                "operationId": "431dd6a856c78571cd923d4dc5b9c26a",
                "responses": {
                    "200": {
                        "description": "Logged out successfully",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/v0/assets/customers/gold-wallets": {
            "get": {
                "tags": [
                    "Assets"
                ],
                "summary": "Get the authenticated customer's gold wallets",
                "description": "Returns the current authenticated customer wallets from the shared gold wallet store.",
                "operationId": "b3d6a2e2efc8f69c9f01da1646f9ff49",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/GoldWallet"
                                            }
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "GoldWallet": {
                "title": "Gold Wallet",
                "description": "A gold wallet belonging to a user.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "wallet_reference": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "available_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "reserved_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "weight_unit": {
                        "type": "string",
                        "example": "gram"
                    },
                    "purity": {
                        "type": "string",
                        "example": "0.999900"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "last_transaction_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer",
                "description": "Enter your Sanctum token"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Customer authentication and session endpoints"
        },
        {
            "name": "Assets",
            "description": "Customer assets and gold wallets"
        }
    ]
}