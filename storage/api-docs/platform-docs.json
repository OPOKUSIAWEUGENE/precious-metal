    "components": {
        "schemas": {
            "GoldWallet": {
                "title": "Gold Wallet",
                "description": "A gold wallet belonging to a user.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "wallet_reference": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "available_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "reserved_weight": {
                        "type": "string",
                        "example": "0.00000000"
                    },
                    "weight_unit": {
                        "type": "string",
                        "example": "gram"
                    },
                    "purity": {
                        "type": "string",
                        "example": "0.999900"
                    },
                    "status": {
                        "type": "string",
                        "example": "active"
                    },
                    "last_transaction_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
