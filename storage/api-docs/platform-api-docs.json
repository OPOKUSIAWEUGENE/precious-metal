{
    "openapi": "3.0.0",
    "info": {
        "title": "Platform Operator API",
        "description": "API documentation for Platform Management, User Management, and Customer Administration.",
        "contact": {
            "email": "admin-support@neutek.local"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api",
            "description": "Primary API Server"
        }
    ],
    "paths": {
        "/v0/auth/platform-managers/login": {
            "post": {
                "tags": [
                    "Platform Authentication"
                ],
                "summary": "Platform Manager Login",
                "operationId": "2efab4f87002f60e0da713bf2f14684b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@neutek.local"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/v0/auth/platform-managers/logout": {
            "post": {
                "tags": [
                    "Platform Authentication"
                ],
                "summary": "Platform Manager Logout",
                "operationId": "e39594a68a77044b0d5174f0b7386c85",
                "responses": {
                    "200": {
                        "description": "Logged out successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/v0/auth/platform-managers/password/request": {
            "post": {
                "tags": [
                    "Platform Authentication"
                ],
                "summary": "Request Password Reset",
                "operationId": "077031f6165b3b75bb2c8893ff181fa6",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@neutek.local"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset link sent"
                    },
                    "404": {
                        "description": "User not found"
                    }
                }
            }
        },
        "/v0/auth/platform-managers/password/reset": {
            "post": {
                "tags": [
                    "Platform Authentication"
                ],
                "summary": "Reset Password",
                "operationId": "7886356f457645ee819e0503d57c2e7e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@neutek.local"
                                    },
                                    "token": {
                                        "type": "string",
                                        "example": "123456"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "newpassword123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successful"
                    },
                    "400": {
                        "description": "Invalid token or data"
                    }
                }
            }
        },
